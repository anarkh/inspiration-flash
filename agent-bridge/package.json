{
  "name": "@ranarkh/agent-bridge",
  "version": "0.1.8",
  "description": "Local bridge for connecting Codex and Claude Code agents.",
  "type": "module",
  "author": "anarkhli",
  "repository": {
    "type": "git",
    "url": "https://github.com/anarkh/inspiration-flash",
    "directory": "agent-bridge"
  },
  "bin": {
    "agent-bridge": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "agent",
    "bridge",
    "codex",
    "claude-code",
    "hooks",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/cli/index.js",
    "dev": "node ./src/cli/index.ts",
    "test": "node --test ./test/agents/**/*.test.ts ./test/hooks/*.test.ts ./test/bridge/*.test.ts ./test/integrations/*.test.ts ./test/cli/*.test.ts ./test/service/*.test.ts ./test/dashboard/*.test.ts ./test/terminal/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
