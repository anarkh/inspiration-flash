    },
    {
      "id": "fog-gates-follow-pressure",
      "steps": [
        { "do": "fight", "node": "fog_lesser_demon" },
        { "do": "walk", "path": ["blood_rune_trap"] },
        { "do": "observe", "as": "gateAtOne", "gate": "left_watch_trap" },
        { "do": "trap", "choice": "risk" },
        { "do": "attempt", "as": "closedMove", "command": { "type": "run/move", "nodeId": "left_watch_trap" } },
        { "do": "observe", "as": "fogAfterRejectedMove", "law": ["law.fogPressure"] },
        { "do": "event", "eventId": "blood_rune_stair", "optionId": "breathe_through_runes" },
        { "do": "walk", "path": ["cracked_portal", "sealed_cache"] },
        { "do": "collect" },
        { "do": "walk", "path": ["cracked_portal", "blood_rune_trap"] },
        { "do": "observe", "as": "gateAtZero", "gate": "left_watch_trap" },
        { "do": "attempt", "as": "openMove", "command": { "type": "run/move", "nodeId": "left_watch_trap" } }
      ],
      "expected": {
        "gateAtOne": { "from": "blood_rune_trap", "gateId": "demon_clear_blood_stair", "isOpen": false, "blockReason": "雾压需降至 0 或以下；先去雾后暗格或静默香案减压。" },
        "closedMove": { "status": "rejected", "code": "illegal-move", "message": "left_watch_trap is not a legal adjacent destination from blood_rune_trap." },
        "fogAfterRejectedMove": { "law.fogPressure": 2 },
        "gateAtZero": { "from": "blood_rune_trap", "gateId": "demon_clear_blood_stair", "isOpen": true, "blockReason": null },
