        "cacheBreathing": { "damageTaken": 0 },
        "clampedAtZero": { "law.fogPressure": 0, "resolvedEventIds": ["blood_rune_stair", "mist_sealed_cache"] },
        "repeatEvent": { "status": "rejected", "code": "domain-rejected", "message": "这个关卡事件已经结算过，主神不会重复发放奖励。" },
        "roundtrip": {
          "law": { "kind": "demon_tower", "fogPressure": 0 },
