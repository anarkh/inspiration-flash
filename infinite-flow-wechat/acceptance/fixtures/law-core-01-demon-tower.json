  "scenarios": [
    {
      "id": "fog-rises-on-damage-and-clamps",
      "steps": [
        { "do": "observe", "as": "entry", "law": ["law", "display", "modifiers.encounter"] },
        { "do": "fight", "node": "fog_lesser_demon" },
        { "do": "observe", "as": "afterMonster", "law": ["law.fogPressure", "display.status", "display.severity"] },
        { "do": "walk", "path": ["blood_rune_trap"] },
        { "do": "trap", "choice": "risk", "as": "bloodRuneTrap" },
        { "do": "observe", "as": "afterTrap", "law": ["law.fogPressure", "display.severity", "modifiers.encounter.allStatsPercent"] },
        { "do": "event", "eventId": "blood_rune_stair", "optionId": "send_pet_first", "as": "petProbeFails" },
        { "do": "observe", "as": "afterEvent", "law": ["law.fogPressure", "display.status", "display.targetReached", "modifiers.encounter.allStatsPercent"] },
        { "do": "walk", "path": ["fog_lesser_demon", "ash_pit_trap"] },
        { "do": "trap", "choice": "risk", "as": "ashPitTrap" },
        { "do": "observe", "as": "clamped", "law": ["law.fogPressure", "clearedNodeIds"] }
      ],
      "expected": {
