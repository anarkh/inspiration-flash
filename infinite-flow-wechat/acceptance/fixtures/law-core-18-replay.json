  "scenarios": [
    {
      "id": "takes-in-order-route-and-boss-snapshot",
      "steps": [
        { "do": "observe", "as": "entry", "law": ["law.takes", "law.route", "law.bossSnapshot", "display.title", "display.status", "display.severity", "display.meter"] },
        { "do": "walk", "path": ["script_stacks"] },
        { "do": "observe", "as": "sequenceRouteBefore", "gate": "sequence_route" },
        { "do": "walk", "path": ["take_alpha"] },
        { "do": "observe", "as": "alphaExitBefore", "gate": "continuity_break_trap" },
        { "do": "fight", "node": "take_alpha" },
        { "do": "observe", "as": "alphaRecorded", "law": ["law.takes.0.action", "display.meter"] },
        { "do": "observe", "as": "alphaExitAfter", "gate": "continuity_break_trap" },
        { "do": "walk", "path": ["continuity_break_trap"] },
        { "do": "trap", "choice": "risk" },
        { "do": "observe", "as": "betaEntryOpen", "gate": "take_beta" },
        { "do": "walk", "path": ["take_beta"] },
        { "do": "fight", "node": "take_beta", "opening": ["guard"] },
        { "do": "command", "command": { "type": "node/resolve-equipment-loot" } },
        { "do": "walk", "path": ["take_gamma"] },
        { "do": "fight", "node": "take_gamma", "opening": ["technique", "art"] },
        { "do": "observe", "as": "threeTakes", "law": ["law.takes.0.action", "law.takes.1.action", "law.takes.2.action", "display.severity", "display.meter"] },
        { "do": "observe", "as": "bossGateBeforeRoute", "gate": "final_cut_director" },
        { "do": "command", "command": { "type": "law/select-combat-replay-route", "route": "sequence" }, "as": "selectSequence" },
        { "do": "observe", "as": "routeSelected", "law": ["law.route", "display.severity", "display.targetReached"] },
        { "do": "attempt", "as": "secondRoute", "command": { "type": "law/select-combat-replay-route", "route": "burst" } },
        { "do": "observe", "as": "bossGateAfterRoute", "gate": "final_cut_director" },
        { "do": "walk", "path": ["final_cut_director"] },
        { "do": "select", "node": "final_cut_director" },
        { "do": "observe", "as": "frozen", "law": ["law.bossSnapshot.route", "law.bossSnapshot.takes.0.action", "law.bossSnapshot.takes.1.action", "law.bossSnapshot.takes.2.action", "display.severity"] },
        { "do": "observe", "as": "roundtrip", "roundtrip": ["law.route", "law.bossSnapshot.route", "law.takes.2.action"] }
      ],
      "expected": {
        "entry": { "law.takes": [null, null, null], "law.route": null, "law.bossSnapshot": null, "display.title": "战痕复演律", "display.status": "1:未录制，2:未录制，3:未录制，路线:未选择，Boss快照:未冻结", "display.severity": "danger", "display.meter": { "value": 0, "max": 3 } },
        "sequenceRouteBefore": { "from": "script_stacks", "gateId": "combat_replay_script_stacks_to_sequence_route", "isOpen": false, "blockReason": "三段母带完成后选择顺序路线；其余路线将永久关闭。" },
        "alphaExitBefore": { "from": "take_alpha", "gateId": "combat_replay_take_alpha_to_continuity_break_trap", "isOpen": false, "blockReason": "录制当前战斗母带后才能离开。" },
        "alphaRecorded": { "law.takes.0.action": "attack", "display.meter": { "value": 1, "max": 3 } },
        "alphaExitAfter": { "from": "take_alpha", "gateId": "combat_replay_take_alpha_to_continuity_break_trap", "isOpen": true, "blockReason": null },
        "betaEntryOpen": { "from": "continuity_break_trap", "gateId": "combat_replay_continuity_break_trap_to_take_beta", "isOpen": true, "blockReason": null },
        "threeTakes": { "law.takes.0.action": "attack", "law.takes.1.action": "guard", "law.takes.2.action": "art", "display.severity": "warning", "display.meter": { "value": 3, "max": 3 } },
        "bossGateBeforeRoute": { "from": "take_gamma", "gateId": "combat_replay_take_gamma_to_final_cut_director", "isOpen": false, "blockReason": "需同时满足这条战痕复演门的全部条件。" },
        "selectSequence": { "damageTaken": 0 },
        "routeSelected": { "law.route": "sequence", "display.severity": "stable", "display.targetReached": true },
        "secondRoute": { "status": "rejected", "code": "domain-rejected", "message": "The command did not produce a domain transition." },
        "bossGateAfterRoute": { "from": "take_gamma", "gateId": "combat_replay_take_gamma_to_final_cut_director", "isOpen": true, "blockReason": null },
        "frozen": { "law.bossSnapshot.route": "sequence", "law.bossSnapshot.takes.0.action": "attack", "law.bossSnapshot.takes.1.action": "guard", "law.bossSnapshot.takes.2.action": "art", "display.severity": "resolved" },
        "roundtrip": { "law.route": "sequence", "law.bossSnapshot.route": "sequence", "law.takes.2.action": "art" }
      }
