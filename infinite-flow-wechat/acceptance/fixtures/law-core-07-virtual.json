          "display": { "title": "终局回声", "status": "分布均衡，克制关闭", "severity": "resolved", "meter": null, "targetReached": true },
          "modifiers.outgoingDamage": { "forcePercent": 0, "artPercent": 0 },
          "modifiers.guardEffectPercent": 0
        }
