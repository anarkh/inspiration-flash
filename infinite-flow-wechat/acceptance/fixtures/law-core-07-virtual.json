          "display.targetReached": false,
          "combatOpenings": {
            "void_knight": { "isBoss": false, "style": "force" },
            "first_echo_patrol": { "isBoss": false, "style": "art" },
            "echo_gate_guard": { "isBoss": false, "style": "guard" }
          }
        },
        "balancedCoreOpen": { "from": "growth_mirror_trap", "gateId": "citadel_balanced_core_lane", "isOpen": true, "blockReason": null },
        "lockedBalanced": {
