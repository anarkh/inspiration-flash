        "balancedCoreClosed": { "from": "growth_mirror_trap", "gateId": "citadel_balanced_core_lane", "isOpen": false, "blockReason": "力、术、守均有胜场且次数差不超过 1 后开放。" },
        "balancedPreview": {
          "display.status": "开局分布均衡",
