        { "do": "observe", "as": "lockedForce", "law": ["law", "display.status", "display.severity", "display.targetReached", "modifiers.outgoingDamage", "modifiers.guardEffectPercent", "combatOpenings"] },
        { "do": "attempt", "as": "bossOpeningAttack", "command": { "type": "combat/act", "action": "attack" } },
