        { "do": "fight", "node": "void_knight" },
        { "do": "observe", "as": "forcePreview", "law": ["display.status", "display.severity", "combatOpenings"] },
        { "do": "observe", "as": "forceLaneOpen", "gate": "identity_trap" },
        { "do": "walk", "path": ["gate_oath_cache", "citadel_gate", "identity_trial_reward", "terminal_cache", "broken_name_trap"] },
        { "do": "trap", "choice": "risk" },
        { "do": "walk", "path": ["main_god_echo"] },
