      "steps": [
        { "do": "observe", "as": "entry", "law": ["law.revealedEvidenceIds", "law.contaminatedEvidenceIds", "law.pendingVerdictNodeId", "law.accusedSuspect", "law.accusationCorrect", "law.bossVerdictSnapshot", "display.title"] },
        { "do": "walk", "path": ["residue_sterility_trap"] },
