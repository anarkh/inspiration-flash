        "pendingVerdict": { "law.pendingVerdictNodeId": "verdict_chamber" },
        "leaveWhilePending": { "status": "rejected", "code": "departure-blocked", "message": "原始裁决尚未完成，请先选择指控对象。" },
        "accuse": { "damageTaken": 0 },
        "verdict": { "law.accusedSuspect": "route_surveyor", "law.accusationCorrect": true, "law.accusationTrustedCount": 1, "law.pendingVerdictNodeId": null },
        "judgeGateOpen": { "from": "verdict_chamber", "gateId": "false_testimony_verdict_chamber_to_false_testimony_judge", "isOpen": true, "blockReason": null },
        "secondAccusation": { "status": "rejected", "code": "domain-rejected", "message": "The command did not produce a domain transition." },
