        "chamberBeforeEvidence": { "from": "residue_sterility_trap", "gateId": "false_testimony_residue_sterility_trap_to_verdict_chamber", "isOpen": false, "blockReason": "至少揭示一份证据后开放。" },
        "counterTrap": { "damageTaken": 0 },
