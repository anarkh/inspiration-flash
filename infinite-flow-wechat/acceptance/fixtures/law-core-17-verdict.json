        "roundtrip": { "law.accusedSuspect": "route_surveyor", "law.bossVerdictSnapshot": { "suspect": "route_surveyor", "correct": true, "trustedCount": 1, "appealed": false, "eliminatedSuspects": ["records_keeper"] } }
      }
