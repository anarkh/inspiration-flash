        { "do": "trap", "choice": "risk", "as": "riskTrap" },
        { "do": "observe", "as": "contaminated", "law": ["law.revealedEvidenceIds", "law.contaminatedEvidenceIds"] },
        { "do": "walk", "path": ["residue_evidence"] },
        { "do": "collect" },
