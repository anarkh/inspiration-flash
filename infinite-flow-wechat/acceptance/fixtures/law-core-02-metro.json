      }
    },
    {
      "id": "signal-cache-calibrates-and-gates-follow-tide",
      "steps": [
        { "do": "collect" },
        { "do": "walk", "path": ["tide_boatman"] },
        { "do": "fight", "node": "tide_boatman" },
        { "do": "observe", "as": "gateAtMirror", "gate": "mirror_tide_trap" },
        { "do": "attempt", "as": "closedMove", "command": { "type": "run/move", "nodeId": "mirror_tide_trap" } },
