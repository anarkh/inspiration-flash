        { "do": "observe", "as": "gateAtEbb", "gate": "mirror_tide_trap" },
        { "do": "walk", "path": ["mirror_tide_trap"] },
        { "do": "trap", "choice": "risk", "as": "ebbTrap" },
        { "do": "walk", "path": ["rail_portal", "spare_train_portal", "wet_ticket_hall", "signal_cache"] },
        { "do": "observe", "as": "beforeCalibration", "law": ["law.tide"] },
        { "do": "collect" },
        { "do": "observe", "as": "calibrated", "law": ["law.tide", "display.status", "display.targetReached"] },
        { "do": "observe", "as": "roundtrip", "roundtrip": ["law", "clearedNodeIds"] }
      ],
      "expected": {
