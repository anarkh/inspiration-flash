        "ebbTrap": { "damageTaken": 12 },
        "beforeCalibration": { "law.tide": "flood" },
        "calibrated": { "law.tide": "ebb", "display.status": "退潮", "display.targetReached": true },
        "roundtrip": {
          "law": { "kind": "metro_abyss", "tide": "ebb" },
          "clearedNodeIds": ["platform_arrival", "tide_boatman", "reflection_fork", "mirror_tide_trap", "signal_cache"]
        }
      }
