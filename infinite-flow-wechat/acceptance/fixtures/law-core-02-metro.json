    { "op": "replace", "path": ["state", "player", "base"], "value": { "body": 5, "spirit": 3, "agility": 3, "luck": 2 } },
    { "op": "replace", "path": ["state", "learnedMethods"], "value": ["mist_breathing"] }
  ],
  "entry": { "dungeonId": "metro_abyss", "protocolId": "standard", "hiddenTaskSeed": 305419896 },
  "runMutations": [
