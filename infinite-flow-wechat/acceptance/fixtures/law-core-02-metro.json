  "scenarios": [
    {
      "id": "tide-cycles-on-first-clears",
      "steps": [
        { "do": "observe", "as": "entry", "law": ["law", "display", "modifiers.trap"] },
        { "do": "collect" },
        { "do": "observe", "as": "afterFirstClear", "law": ["law.tide", "display.status", "display.severity", "display.meter"] },
        { "do": "walk", "path": ["tide_boatman"] },
        { "do": "fight", "node": "tide_boatman" },
        { "do": "observe", "as": "mirrorTide", "law": ["law.tide", "display.status", "display.severity", "display.meter", "display.targetReached", "modifiers.trap", "modifiers.encounter.allStatsPercent"] },
        { "do": "walk", "path": ["reflection_fork"] },
        { "do": "trap", "choice": "risk", "as": "mirrorTrap" },
        { "do": "observe", "as": "cycledToEbb", "law": ["law.tide", "clearedNodeIds"] }
      ],
      "expected": {
        "entry": {
          "law": { "kind": "metro_abyss", "tide": "ebb" },
          "display": { "title": "末班潮序", "status": "退潮", "severity": "stable", "meter": { "value": 0, "max": 2 }, "targetReached": true },
          "modifiers.trap": { "damagePercent": 0, "dcPercent": 0 }
        },
        "afterFirstClear": { "law.tide": "flood", "display.status": "涨潮", "display.severity": "warning", "display.meter": { "value": 1, "max": 2 } },
        "mirrorTide": {
          "law.tide": "mirror",
          "display.status": "镜潮",
          "display.severity": "danger",
