      "expected": {
        "entry": { "law.noise": 0, "law.pendingRelayNodeId": null, "law.resolvedRelayChoices": {}, "law.bossNoiseSnapshot": null, "display": { "title": "寂声广播律", "status": "噪声 0/6，北中继:未定，中央中继:未定，南中继:未定，静默 0，播送 0，Boss快照 未冻结", "severity": "stable", "meter": { "value": 0, "max": 6 }, "targetReached": false } },
        "trapNoise": { "law.noise": 1, "display.severity": "stable" },
        "pendingNorth": { "law.pendingRelayNodeId": "north_relay_console", "display.status": "噪声 1/6，北中继:未定，中央中继:未定，南中继:未定，静默 0，播送 0，待调谐 北中继，Boss快照 未冻结", "display.severity": "danger" },
        "leaveWhilePending": { "status": "rejected", "code": "departure-blocked", "message": "广播中继尚未调谐，请先选择静默或播送。" },
        "muteNorth": { "damageTaken": 0 },
        "twoMutes": { "law.noise": 0, "display.status": "噪声 0/6，北中继:静默，中央中继:未定，南中继:静默，静默 2，播送 0，Boss快照 未冻结", "display.severity": "stable" },
        "silentArchiveOpen": { "from": "north_echo_cache", "gateId": "broadcast_silent_archive_gate", "isOpen": true, "blockReason": null },
        "bossGateTwoRelays": { "from": "broadcast_memory_stage", "gateId": "broadcast_memory_boss_gate", "isOpen": false, "blockReason": "三座中继全部调谐后，末频道王门开放。" },
        "broadcastCentral": { "damageTaken": 0 },
        "relayWithoutPending": { "status": "rejected", "code": "domain-rejected", "message": "The command did not produce a domain transition." },
        "allTuned": { "law.noise": 2, "law.resolvedRelayChoices": { "north_relay_console": "mute", "south_relay_console": "mute", "central_relay_console": "broadcast" }, "display.status": "噪声 2/6，北中继:静默，中央中继:播送，南中继:静默，静默 2，播送 1，Boss快照 未冻结", "display.severity": "resolved", "display.targetReached": true },
        "bossGateOpen": { "from": "broadcast_memory_stage", "gateId": "broadcast_memory_boss_gate", "isOpen": true, "blockReason": null },
        "frozen": { "law.bossNoiseSnapshot": 2, "display.status": "噪声 2/6，北中继:静默，中央中继:播送，南中继:静默，静默 2，播送 1，Boss快照 2", "modifiers.encounter": { "allStatsPercent": 0, "defensePercent": 4, "artPowerPercent": 0 } },
        "roundtrip": { "law.noise": 2, "law.resolvedRelayChoices": { "north_relay_console": "mute", "south_relay_console": "mute", "central_relay_console": "broadcast" }, "law.bossNoiseSnapshot": 2 }
      }
