        { "do": "collect" },
        { "do": "observe", "as": "pendingNorth", "law": ["law.pendingRelayNodeId", "display.status", "display.severity"] },
        { "do": "attempt", "as": "leaveWhilePending", "command": { "type": "run/move", "nodeId": "north_echo_cache" } },
