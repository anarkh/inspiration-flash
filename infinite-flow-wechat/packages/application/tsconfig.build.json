    "paths": {
      "@infinite-flow/core": ["../core/dist/index.d.ts"],
      "@infinite-flow/core/*": ["../core/dist/*.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts"]
}
