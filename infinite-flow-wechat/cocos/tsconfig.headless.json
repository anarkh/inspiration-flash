{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": [
      "minigame-api-typings"
    ]
  },
  "include": [
    "assets/scripts/**/*.ts",
    "headless/**/*.d.ts"
  ]
}
