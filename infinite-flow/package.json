{
  "name": "infinite-flow",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:audit": "vite-node scripts/asset-inventory.ts",
    "knowledge:verify": "vite-node scripts/verify-knowledge-base.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:ui:all": "SMOKE_SUITE=all node scripts/smoke-ui.mjs",
    "test": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.1"
  }
}
